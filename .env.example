# ==============================================================================
# Campus Compass - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local to customize your environment.
# Note: The application runs with persistent local storage out-of-the-box!
# You only need to fill these if you want to connect your own external Firebase project.

# Optional: Google Firebase Project Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
